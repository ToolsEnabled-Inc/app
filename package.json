{
  "name": "mission-control",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "main": "shell/main.cjs",
  "author": "ToolsEnabled, Inc.",
  "scripts": {
    "data:generate": "node tools/gen-fleet.mjs && node tools/gen-agents.mjs && node tools/gen-metrics.mjs && node tools/gen-ops.mjs && node tools/gen-ledger.mjs && node tools/gen-coordinator.mjs",
    "test": "node tools/check-suites-discovered.mjs && npm run test:data",
    "test:data": "node --test --test-concurrency=1 tools/test/*.test.mjs",
    "dev": "vite --port 4600 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4600 --strictPort",
    "app": "node shell/launch.cjs",
    "verify": "node tools/test-ratchet.mjs",
    "smoke:agent-ui": "node tools/run-agent-from-ui-smoke.cjs",
    "pack:capability": "node tools/pack-capability-layer.mjs",
    "check:boundary": "node tools/check-payload-boundary.mjs",
    "dist": "npm run verify && node tools/check-research-queue.mjs && node tools/check-data-schemas.mjs && npm run build && npm run pack:capability && node tools/check-payload-boundary.mjs capability && node tools/require-clean-tree.mjs dist && electron-builder --win nsis && node tools/strip-build-diagnostics.mjs release && node tools/check-asar-manifest.mjs release/win-unpacked && node tools/check-no-owner-data.mjs release/win-unpacked && node tools/check-payload-boundary.mjs release/win-unpacked/resources/capability && node tools/smoke-packaged.mjs release/win-unpacked",
    "release:cut": "node tools/release-packager/cut-release-candidate.mjs",
    "release:serve": "node tools/release-packager/serve-candidate.mjs"
  },
  "devDependencies": {
    "culori": "^4.0.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@carbon/colors": "11.55.0",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "d3-array": "^3.2.4",
    "d3-force": "^3.0.0",
    "echarts": "6.1.0"
  },
  "productName": "Mission Control",
  "build": {
    "appId": "com.toolsenabled.missioncontrol",
    "copyright": "Copyright © 2026 Mission Control",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "shell/**",
      "!tools/**",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "capability",
        "to": "capability"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "shell/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "uninstallDisplayName": "${productName}"
    }
  }
}
